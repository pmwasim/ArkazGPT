# ─────────────────────────────────────────────────────────────────────────────
# ArkazGPT — Production Environment Variables
# Copy this file to .env on your VPS and fill in all values.
# NEVER commit this file with real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=arkazgpt
POSTGRES_USER=arkazgpt
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ── Next.js / NextAuth ────────────────────────────────────────────────────────
# Your public domain (no trailing slash)
NEXTAUTH_URL=https://app.yourdomain.com

# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_THIS_RANDOM_SECRET

# DATABASE_URL is built automatically by docker-compose from the values above.
# Only set this if running without docker-compose:
# DATABASE_URL=postgresql://arkazgpt:YOUR_PASSWORD@localhost:5432/arkazgpt?schema=public
